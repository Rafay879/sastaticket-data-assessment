{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWatermark",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "${watermark_table_arn}"
    },
    {
      "Sid": "PutBronzeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "${bronze_bucket_arn}/*"
    },
    {
      "Sid": "GetIngestionSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:${region}:${account_id}:secret:${project_prefix}/ingestion/*"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/${project_prefix}-${environment}-*-ingestion:*"
    }
  ]
}
